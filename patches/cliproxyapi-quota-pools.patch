diff --git a/sdk/cliproxy/auth/codex_quota_pool.go b/sdk/cliproxy/auth/codex_quota_pool.go
new file mode 100644
index 0000000..ea7da9d
--- /dev/null
+++ b/sdk/cliproxy/auth/codex_quota_pool.go
@@ -0,0 +1,57 @@
+package auth
+
+import (
+	"strings"
+	"time"
+)
+
+// codexQuotaPool identifies only verified pool memberships. Unknown models keep
+// the conservative credential-wide behavior instead of guessing their limits.
+func codexQuotaPool(model string) string {
+	switch canonicalModelKey(model) {
+	case "gpt-5.3-codex-spark":
+		return "codex-spark"
+	case "gpt-5.5", "gpt-5.6-luna":
+		return "codex-main"
+	default:
+		return ""
+	}
+}
+
+// applyCodexQuotaPoolCooldown preserves the upstream deadline within its pool.
+// Spark has an additional allowance, independent of the standard Codex pool.
+// This function neither clears an existing limit nor suppresses upstream 429s.
+func applyCodexQuotaPoolCooldown(auth *Auth, model string, failed *ModelState, next, now time.Time) bool {
+	if auth == nil || !strings.EqualFold(strings.TrimSpace(auth.Provider), "codex") {
+		return false
+	}
+	pool := codexQuotaPool(model)
+	if pool == "" {
+		return false
+	}
+	// Materialize known siblings even if they have not been requested yet.
+	for _, sibling := range []string{"gpt-5.3-codex-spark", "gpt-5.5", "gpt-5.6-luna"} {
+		if codexQuotaPool(sibling) != pool {
+			continue
+		}
+		state := ensureModelState(auth, sibling)
+		if state == failed || state.Status == StatusDisabled {
+			continue
+		}
+		deadline := next
+		if state.Quota.Exceeded && state.Quota.NextRecoverAt.After(deadline) {
+			deadline = state.Quota.NextRecoverAt
+		}
+		state.Unavailable = true
+		state.Status = StatusError
+		state.UpdatedAt = now
+		state.NextRetryAfter = deadline
+		state.LastError = cloneError(failed.LastError)
+		state.StatusMessage = failed.StatusMessage
+		applyCooldownFields(&state.Quota, QuotaState{
+			Exceeded: true, Reason: "quota_pool", NextRecoverAt: deadline,
+			BackoffLevel: failed.Quota.BackoffLevel,
+		})
+	}
+	return true
+}
