@@ -0,0 +1,94 @@
+package auth
+
+import (
+	"context"
+	"net/http"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestCodexQuotaPoolIsolation(t *testing.T) {
+	withQuotaCooldownEnabled(t)
+	models := []string{"gpt-5.3-codex-spark", "gpt-5.5", "gpt-5.6-luna"}
+	for _, exhausted := range models {
+		t.Run(exhausted, func(t *testing.T) {
+			manager := NewManager(nil, &RoundRobinSelector{}, nil)
+			manager.RegisterExecutor(&customStreamMockExecutor{identifier: "codex"})
+			id := "quota-pool-" + exhausted
+			registry.GetGlobalRegistry().RegisterClient(id, "codex", []*registry.ModelInfo{
+				{ID: models[0]}, {ID: models[1]}, {ID: models[2]},
+			})
+			t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(id) })
+			if _, errRegister := manager.Register(context.Background(), &Auth{ID: id, Provider: "codex", Status: StatusActive}); errRegister != nil {
+				t.Fatal(errRegister)
+			}
+			retryAfter := time.Hour
+			before := time.Now()
+			manager.MarkResult(context.Background(), Result{
+				AuthID: id, Provider: "codex", Model: exhausted, CredentialScope: true,
+				Error: &Error{HTTPStatus: http.StatusTooManyRequests, Message: "usage_limit_reached"}, RetryAfter: &retryAfter,
+			})
+			auth, _ := manager.GetByID(id)
+			if auth.Quota.Reason == "credential_quota" {
+				t.Fatal("known pool exhaustion became credential-wide")
+			}
+			for _, requested := range models {
+				wantBlocked := codexQuotaPool(exhausted) == codexQuotaPool(requested)
+				blocked, _, deadline := isAuthBlockedForModel(auth, requested, before.Add(time.Minute))
+				if blocked != wantBlocked {
+					t.Fatalf("exhausted=%s requested=%s blocked=%t want=%t", exhausted, requested, blocked, wantBlocked)
+				}
+				if wantBlocked && deadline.Before(before.Add(retryAfter)) {
+					t.Fatal("upstream reset was shortened")
+				}
+				_, _, _, errSelect := manager.pickNextMixed(context.Background(), []string{"codex"}, requested, cliproxyexecutor.Options{}, nil)
+				if (errSelect != nil) != wantBlocked {
+					t.Fatalf("scheduler pool mismatch: model=%s err=%v", requested, errSelect)
+				}
+			}
+		})
+	}
+}
+
+func TestCodexQuotaPoolUnknownAndOtherProviderRemainCredentialScoped(t *testing.T) {
+	withQuotaCooldownEnabled(t)
+	for _, provider := range []string{"codex", "claude"} {
+		manager := NewManager(nil, &RoundRobinSelector{}, nil)
+		id := "unknown-pool-" + provider
+		if _, errRegister := manager.Register(context.Background(), &Auth{ID: id, Provider: provider, Status: StatusActive}); errRegister != nil {
+			t.Fatal(errRegister)
+		}
+		retryAfter := time.Hour
+		manager.MarkResult(context.Background(), Result{AuthID: id, Provider: provider, Model: "unknown-model", CredentialScope: true,
+			Error: &Error{HTTPStatus: 429, Message: "quota"}, RetryAfter: &retryAfter})
+		auth, _ := manager.GetByID(id)
+		if auth.Quota.Reason != "credential_quota" {
+			t.Fatal("unknown credential-wide quota was weakened")
+		}
+	}
+}
+
+func TestCodexQuotaPoolPreservesExistingRestrictions(t *testing.T) {
+	now := time.Now()
+	for _, disabled := range []bool{false, true} {
+		sibling := &ModelState{Status: StatusError, Unavailable: true,
+			NextRetryAfter: now.Add(2 * time.Hour),
+			Quota:          QuotaState{Exceeded: true, NextRecoverAt: now.Add(2 * time.Hour)}}
+		if disabled {
+			sibling.Status = StatusDisabled
+		}
+		auth := &Auth{Provider: "codex", ModelStates: map[string]*ModelState{"gpt-5.5": sibling}}
+		if !applyCodexQuotaPoolCooldown(auth, "gpt-5.6-luna", &ModelState{}, now.Add(time.Hour), now) {
+			t.Fatal("known pool not handled")
+		}
+		if sibling.NextRetryAfter.Before(now.Add(2 * time.Hour)) {
+			t.Fatal("existing longer cooldown shortened")
+		}
+		if disabled && sibling.Status != StatusDisabled {
+			t.Fatal("disabled model was re-enabled")
+		}
+	}
+}
