LICENSE
!LICENSE
Procfile
nixpacks.toml
railway.json

# 기타
.DS_Store
*.log
tmp/

# 런타임 사용자 데이터/상태 — COPY . . 이전에 빌드 컨텍스트에서 제외해야 합니다.
# 루트 경로만 제외해 services/data 같은 소스 디렉터리는 보존합니다.
/data/
/cache/
/logs/
/app-backups/
/backups/
/data_volume_backups/
/downloads/
/services/cache/
/.agent/
/.agents/
/.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.jsonl
