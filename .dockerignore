**/.env.*
!**/.env.example

# 테스트
tests/
pytest_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Node (Tailwind 빌드용 - 빌드 결과물만 필요)
**/node_modules/
**/.next/
**/.turbo/
package-lock.json
!frontend/package-lock.json

# 문서/설정
*.md
