# Git
.git
.gitignore

# Python
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
.eggs/
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# 환경변수 (배포 시 Cloud Run 콘솔에서 설정)
