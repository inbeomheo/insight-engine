# =============================================
# Insight Engine - 환경 변수 설정
# =============================================
# 이 파일을 .env로 복사하고 값을 채워넣으세요
# Railway에서는 Variables 탭에서 설정

# =============================================
# AI Provider API Keys (최소 하나 필수)
# =============================================
# 사용할 AI 서비스의 API 키만 설정하세요.
# API 키가 설정된 프로바이더만 UI에 표시됩니다.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Zhipu AI (GLM) - https://open.bigmodel.cn/usercenter/apikeys
# LiteLLM은 ZAI_API_KEY 환경변수를 사용합니다
ZAI_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Ollama (로컬 LLM) - https://ollama.ai
# 기본값: http://localhost:11434 (Ollama 서버 실행 시 자동 활성화)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter - https://openrouter.ai/keys
# 단일 API 키로 2600+ 모델(Claude, Gemini, Llama, Mistral 등) 접근 가능
OPENROUTER_API_KEY=sk-or-...

# =============================================
# Supadata API (선택 - 자막 백업 서비스)
# =============================================
# YouTube 자막이 차단될 경우 백업으로 사용
# https://supadata.ai/
SUPADATA_API_KEY=

# =============================================
# YouTube API (선택 - 댓글 수집용)
# =============================================
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================
# Supabase (선택 - 없으면 로컬 모드로 동작)
# =============================================
# Supabase Dashboard > Settings > API에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Admin 기능 (계정 삭제 등) - Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================
# 보안 설정 (Supabase 사용 시 권장)
# =============================================
# API 키 암호화용 시크릿 (32자 이상 권장)
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=your-encryption-secret-key-here

# =============================================
# Whisper 음성 인식 (선택 - 자막 없는 영상용)
# =============================================
# 자막이 없는 영상에 대해 오디오를 추출하고 Whisper로 음성 인식
# GPU 권장 (CPU에서도 동작하나 느림)
# 모델 크기: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=base

# =============================================
# 프록시 설정 (선택 - YouTube 자막 차단 우회용)
# =============================================
# YT_HTTP_PROXY=http://your-proxy:port
# YT_HTTPS_PROXY=http://your-proxy:port

# =============================================
# 웹훅 연동 (선택 - n8n, Make, Zapier 등)
# =============================================
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# =============================================
# 웹 검색 보강 (Grounded Generation)
# =============================================
# Tavily API를 사용하여 YouTube 자막 내용을 웹 검색으로 보강
# https://tavily.com/ — 무료 플랜 1,000 요청/월
TAVILY_API_KEY=
# 웹 검색 자동 활성화 여부 (true 설정 시 모든 생성에 적용)
WEB_SEARCH_ENABLED=false
# 검색 결과 최대 개수 (1~10)
WEB_SEARCH_MAX_RESULTS=5

# =============================================
# RAG 지식 참조 (벡터 DB)
# =============================================
# 참고 문서를 업로드하면 콘텐츠 생성 시 자동 참조
RAG_ENABLED=false
CHROMA_DB_PATH=./data/chroma_db
RAG_TOP_K=5

# =============================================
# Rate Limiter / Redis (선택)
# =============================================
# Redis URL — 설정하면 Rate Limiter가 Redis 저장소 사용 (멀티 프로세스 지원)
# 미설정 시 인메모리 폴백 (단일 프로세스 개발용)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiter 전체 on/off (기본: true)
# RATE_LIMIT_ENABLED=true

# =============================================
# Flask 설정
# =============================================
# FLASK_ENV=production
# FLASK_DEBUG=0
