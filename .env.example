# =============================================
# Insight Engine - 환경 변수 설정
# =============================================
# 이 파일을 .env로 복사하고 값을 채워넣으세요
# Railway에서는 Variables 탭에서 설정

# =============================================
# AI Provider API Keys (최소 하나 필수)
# =============================================
# 사용할 AI 서비스의 API 키만 설정하세요.
# API 키가 설정된 프로바이더만 UI에 표시됩니다.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Zhipu AI (GLM) - https://open.bigmodel.cn/usercenter/apikeys
# LiteLLM은 ZAI_API_KEY 환경변수를 사용합니다
ZAI_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Ollama (로컬 LLM) - https://ollama.ai
# 기본값: http://localhost:11434 (Ollama 서버 실행 시 자동 활성화)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter - https://openrouter.ai/keys
# 단일 API 키로 2600+ 모델(Claude, Gemini, Llama, Mistral 등) 접근 가능
OPENROUTER_API_KEY=sk-or-...

# =============================================
# Supadata API (선택 - 자막 백업 서비스)
# =============================================
# YouTube 자막이 차단될 경우 백업으로 사용
# https://supadata.ai/
SUPADATA_API_KEY=

# =============================================
# YouTube API (선택 - 댓글 수집용)
# =============================================
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================
# Supabase (AUTH_MODE=supabase일 때 필수, AUTH_MODE=edge에서는 선택)
# =============================================
# Supabase Dashboard > Settings > API에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Admin 기능 (계정 삭제 등) - Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================
# 보안 설정 (Supabase 사용 시 권장)
# =============================================
# API 키 암호화용 시크릿 (production에서는 32자 이상 랜덤 값 필수)
# SECRET_KEY/METRICS_AUTH_TOKEN과 다른 값이어야 합니다.
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_SECRET=your-encryption-secret-key-here

# =============================================
# Whisper 음성 인식 (선택 - 자막 없는 영상용)
# =============================================
# 자막이 없는 영상에 대해 오디오를 추출하고 Whisper로 음성 인식
# GPU 권장 (CPU에서도 동작하나 느림)
# 모델 크기: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=base

# =============================================
# 프록시 설정 (선택 - YouTube 자막 차단 우회용)
# =============================================
# YT_HTTP_PROXY=http://your-proxy:port
# YT_HTTPS_PROXY=http://your-proxy:port

# =============================================
# 웹훅 연동 (선택 - n8n, Make, Zapier 등)
# =============================================
WEBHOOK_URL=
WEBHOOK_ENABLED=false
# Zapier/Make/IFTTT inbound endpoints:
#   X-Insight-Webhook-Secret: <AUTOMATION_WEBHOOK_SECRET>
# production에서는 이 값이 없으면 해당 inbound endpoint가 fail-closed 됩니다.
# AUTOMATION_WEBHOOK_SECRET=

# =============================================
# 결제 Provider (선택)
# =============================================
# 결제를 사용하지 않으면 비워둡니다.
# production에서 하나라도 설정하면 API key, webhook secret, HTTPS 성공/취소 URL까지 완전해야 합니다.
# test/sandbox key는 production readiness에서 거부됩니다.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_SUCCESS_URL=https://insight.example.com/billing?success=true
# STRIPE_CANCEL_URL=https://insight.example.com/billing?canceled=true
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_SANDBOX=false
# COINBASE_COMMERCE_API_KEY=
# COINBASE_WEBHOOK_SECRET=

# =============================================
# Signed inbound bot webhooks (선택)
# =============================================
# Slack/Discord webhook endpoints는 provider signature로 검증됩니다.
# Telegram webhook endpoint는 Telegram secret-token 헤더로 검증됩니다.
# production에서 token/key 중 하나라도 설정하면 짝 secret/key까지 완전해야 합니다.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_PUBLIC_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# =============================================
# 웹 검색 보강 (Grounded Generation)
# =============================================
# Tavily API를 사용하여 YouTube 자막 내용을 웹 검색으로 보강
# https://tavily.com/ — 무료 플랜 1,000 요청/월
TAVILY_API_KEY=
# 웹 검색 자동 활성화 여부 (true 설정 시 모든 생성에 적용)
WEB_SEARCH_ENABLED=false
# 검색 결과 최대 개수 (1~10)
WEB_SEARCH_MAX_RESULTS=5

# =============================================
# RAG 지식 참조 (벡터 DB)
# =============================================
# 참고 문서를 업로드하면 콘텐츠 생성 시 자동 참조
RAG_ENABLED=false
CHROMA_DB_PATH=./data/chroma_db
RAG_TOP_K=5

# =============================================
# Rate Limiter / Redis (선택)
# =============================================
# Redis URL — 설정하면 Rate Limiter가 Redis 저장소 사용 (멀티 프로세스 지원)
# production에서는 memory://가 거부되며 redis:// 또는 rediss:// URL이 필요합니다.
# 미설정 시 인메모리 폴백 (단일 프로세스 개발용)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiter 전체 on/off (기본: true). production에서는 false가 거부됩니다.
# RATE_LIMIT_ENABLED=true

# =============================================
# Flask 설정
# =============================================
# FLASK_ENV=production
# Debug flags must stay disabled in production; readiness fails if any are true.
# FLASK_DEBUG=0

# =============================================
# Production 운영 필수값
# =============================================
# FLASK_ENV=production일 때는 아래 값이 모두 필요합니다.
# 시크릿/토큰은 각각 다른 32자 이상 랜덤 값이어야 합니다.
# placeholder, 단순 반복 문자열, 같은 값 재사용은 production readiness에서 거부됩니다.
# 생성:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Flask 세션/서명용 시크릿. ENCRYPTION_SECRET/METRICS_AUTH_TOKEN과 다른 값 사용.
# SECRET_KEY=

# 앱 인증 모드. edge는 Caddy/Ingress Basic Auth로 private app을 보호하고,
# supabase는 앱 자체 Bearer JWT 인증을 필수로 사용합니다.
# AUTH_MODE=edge

# HTTPS origin만 허용됩니다. 로컬/와일드카드 origin은 production에서 거부됩니다.
# Origin 값만 넣고 path/query/fragment/credentials는 넣지 마세요.
# CORS_ORIGINS=https://insight.example.com

# 공개 앱 base URL. 설정하면 production readiness가 HTTPS/public host인지 검증합니다.
# INSIGHT_BASE_URL=https://insight.example.com
# APP_BASE_URL=https://insight.example.com
# 공유 URL origin을 별도 도메인으로 만들 때만 설정합니다. Origin만 허용됩니다.
# PUBLIC_ORIGIN=https://share.insight.example.com

# Host header allowlist. CORS_ORIGINS의 host는 자동 허용됩니다.
# 추가 public host만 쉼표로 나열하세요. wildcard/local host는 production readiness에서 거부됩니다.
# TRUSTED_HOSTS=admin.insight.example.com

# /metrics 보호 토큰. 32자 이상 랜덤 값 사용.
# METRICS_AUTH_TOKEN=

# 백엔드 API 응답 CSP. 미설정 시 production-safe 기본값이 사용됩니다.
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https: blob:; font-src 'self' data: https:; connect-src 'self' https: wss:; media-src 'self' https: blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# Flask 세션 쿠키. production에서는 기본적으로 Secure/HttpOnly/SameSite=Lax가 적용됩니다.
# SESSION_COOKIE_SECURE=true

# Caddy edge Basic Auth. 해시는 `caddy hash-password --plaintext <password>`로 생성합니다.
# .env를 shell에서 source하므로 BASIC_AUTH_HASH는 single quote로 감싸야 합니다.
# BASIC_AUTH_USER=admin
# BASIC_AUTH_HASH='$2a$14$...'

# 멀티 프로세스 rate limit / publish queue 공유 저장소
# REDIS_URL=redis://redis:6379/0

# 발행 큐는 production에서 Redis backend를 사용해야 합니다.
# PUBLISH_QUEUE_BACKEND=redis
# PUBLISH_QUEUE_REDIS_URL=redis://redis:6379/0

# 운영 기본 생성 모델. production에서는 chatmock/* 기본값을 배포 검증이 거부합니다.
# DEFAULT_GENERATION_MODEL=zhipuai/GLM-4.5-Air
# VIDEO_QA_DEFAULT_MODEL=zhipuai/GLM-4.5-Air
# 로컬 ChatMock 테스트가 필요하면 `docker compose -f docker-compose.deploy.yml --profile chatmock up -d chatmock` 후
# CHATMOCK_API_KEY=dummy
# CHATMOCK_BASE_URL=http://chatmock:8000/v1

# app_data 볼륨 백업. APP_DATA_BACKUP_DIR는 APP_DATA_DIR 바깥이어야 합니다.
# APP_DATA_BACKUP_REPLICA_DIR는 운영에서 별도 디스크/네트워크 스토리지/오프호스트 마운트를 권장합니다.
# Docker Compose 배포에서는 아래 *_VOLUME 값을 절대 host path로 바꾸면 외부 마운트/bind mount를 사용합니다.
# APP_DATA_DIR=/app/data
# AGENT_DB_PATH=/app/data/agent_state.db
# CHROMA_DB_PATH=/app/data/chroma_db
# FEEDBACK_DATA_DIR=/app/data/feedback
# FEEDBACK_STORE_DIR=/app/data/feedback
# FINETUNE_OUTPUT_DIR=/app/data/finetune
# GRAPH_STORE_PATH=/app/data/graph_store
# JOB_STORE_DIR=/app/data/jobs
# PREFERENCE_DATA_PATH=/app/data/preferences.jsonl
# SHARE_PAGE_DIR=/app/data/shared_pages
# USER_MEMORY_PATH=/app/data/user_memory
# APP_CACHE_DIR=/app/cache
# AI_CACHE_DB=/app/cache/ai_cache.db
# APP_DATA_BACKUP_DIR=/app/backups
# APP_DATA_BACKUP_REPLICA_DIR=/app/backup-replica
# CONTENT_BACKUP_DIR=/app/backups/content-library
# APP_DATA_BACKUP_VOLUME=/var/backups/insight-engine  # durable mounted storage, not tmpfs/overlay/loopback
# APP_DATA_BACKUP_REPLICA_VOLUME=/mnt/backup-replica/insight-engine  # separate durable mounted storage
# HOST_CHECK_REQUIRE_OVERCOMMIT=true
# HOST_CHECK_REQUIRE_EXTERNAL_BACKUPS=true
# AUTO_BACKUP_INTERVAL_HOURS=6
# APP_DATA_BACKUP_MAX_AGE_HOURS=12
# MAX_BACKUPS=30
# APP_DATA_BACKUP_REPLICA_MAX_BACKUPS=30

# gunicorn worker 중 하나만 APScheduler를 실행하도록 파일락 경로를 고정합니다.
# SCHEDULER_LOCK_FILE=/tmp/insight-engine-scheduler.lock
# /ready가 background scheduler 정지를 감지할 수 있도록 heartbeat 파일 경로를 고정합니다.
# SCHEDULER_HEARTBEAT_FILE=/tmp/insight-engine-scheduler.heartbeat

# 릴리즈 식별자. production readiness와 배포 후 monitor가 누락/placeholder 값을 실패 처리합니다.
# deploy:local/CI는 Git SHA와 UTC build time을 자동 주입하고, 수동 배포에서는 반드시 설정합니다.
# /health 응답과 access log/Sentry release 상관관계에 사용됩니다.
# APP_VERSION=v2.0
# APP_RELEASE=
# GIT_SHA=
# BUILD_TIME=

# 로컬 Docker 배포 후 cleanup은 기본적으로 최근 BuildKit 캐시를 보존합니다.
# 디스크 압박 시 PRUNE_BUILD_CACHE=all, 캐시 pruning 비활성화 시 PRUNE_BUILD_CACHE=0을 사용합니다.
# BUILD_CACHE_PRUNE_UNTIL=168h
# PRUNE_BUILD_CACHE=until=168h
# Docker json-file log rotation for docker-compose.deploy.yml services.
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=5

# Sentry 오류 추적. ERROR_TRACKING_REQUIRED=true이면 DSN 누락 시 verify:production과 /ready가 실패합니다.
# ERROR_TRACKING_REQUIRED=false
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_RELEASE=

# Support Assistant GitHub handoff.
# repo/token/secret 중 하나라도 설정하면 셋 모두 완전해야 production readiness를 통과합니다.
# 브라우저는 이 값을 알면 안 됩니다. 관리자/worker 요청에서만 X-Support-Handoff-Secret으로 보냅니다.
# 32자 이상 랜덤 값을 사용하고 다른 production 시크릿과 재사용하지 마세요.
# SUPPORT_HANDOFF_SECRET=
# SUPPORT_GITHUB_REPO=owner/repo
# SUPPORT_GITHUB_TOKEN=

# 배포 후 외부/cron 모니터링. 실패 시 Slack/Discord/n8n 등 webhook으로 알림을 보낼 수 있습니다.
# 채널 검증: python3 scripts/monitor_readiness.py --send-test-alert
# HTTPS/public host만 사용하세요. local/private IP, credentials 포함 URL은 production readiness에서 거부됩니다.
# INSIGHT_BASE_URL=https://insight.example.com
# MONITOR_ATTEMPTS=2
# MONITOR_TIMEOUT_SECONDS=5
# MONITOR_RETRY_DELAY_SECONDS=5
# MONITOR_METRICS_AUTH_TOKEN=  # optional override; defaults to METRICS_AUTH_TOKEN
# MONITOR_REQUIRE_PUBLIC_HOST=true
# MONITOR_REQUIRE_HTTPS=true
# MONITOR_TLS_MIN_DAYS=21
# MONITOR_WEBHOOK_REQUIRE_HTTPS=true
# MONITOR_WEBHOOK_REQUIRE_PUBLIC_HOST=true
# ALERT_WEBHOOK_REQUIRED=false
# ALERT_WEBHOOK_URL=

# 실제 공개 도메인 cutover 직전 strict gate.
# INSIGHT_BASE_URL=https://insight.example.com
# RELEASE_REQUIRE_CLEAN_GIT=true
# RELEASE_REQUIRE_PUSHED=true
# ERROR_TRACKING_REQUIRED=true
# ALERT_WEBHOOK_REQUIRED=true
# HOST_CHECK_REQUIRE_OVERCOMMIT=true
# HOST_CHECK_REQUIRE_PERSISTENT_OVERCOMMIT=true
# HOST_CHECK_REQUIRE_EXTERNAL_BACKUPS=true
# HOST_CHECK_REQUIRE_BACKUP_MOUNTS=true
