# =============================================
# Insight Engine - 환경 변수 설정
# =============================================
# 이 파일을 .env로 복사하고 값을 채워넣으세요
# Railway에서는 Variables 탭에서 설정

# =============================================
# AI Provider API Keys (최소 하나 필수)
# =============================================
# 사용할 AI 서비스의 API 키만 설정하세요.
# API 키가 설정된 프로바이더만 UI에 표시됩니다.

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Zhipu AI (GLM) - https://open.bigmodel.cn/usercenter/apikeys
# LiteLLM은 ZAI_API_KEY 환경변수를 사용합니다
ZAI_API_KEY=

# DeepSeek - https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Ollama (로컬 LLM) - https://ollama.ai
# 기본값: http://localhost:11434 (Ollama 서버 실행 시 자동 활성화)
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter - https://openrouter.ai/keys
# 단일 API 키로 2600+ 모델(Claude, Gemini, Llama, Mistral 등) 접근 가능
OPENROUTER_API_KEY=sk-or-...

# =============================================
# Supadata API (선택 - 자막 백업 서비스)
# =============================================
# YouTube 자막이 차단될 경우 백업으로 사용
# https://supadata.ai/
SUPADATA_API_KEY=

# =============================================
# YouTube API (선택 - 댓글 수집용)
# =============================================
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# =============================================
# Supabase (선택 - 없으면 로컬 모드로 동작)
# =============================================
# Supabase Dashboard > Settings > API에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Admin 기능 (계정 삭제 등) - Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================
# 보안 설정 (Supabase 사용 시 권장)
# =============================================
# API 키 암호화용 시크릿 (32자 이상 권장)
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_SECRET=your-encryption-secret-key-here

# =============================================
# Whisper 음성 인식 (선택 - 자막 없는 영상용)
# =============================================
# 자막이 없는 영상에 대해 오디오를 추출하고 Whisper로 음성 인식
# GPU 권장 (CPU에서도 동작하나 느림)
# 모델 크기: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=base

# =============================================
# 프록시 설정 (선택 - YouTube 자막 차단 우회용)
# =============================================
# YT_HTTP_PROXY=http://your-proxy:port
# YT_HTTPS_PROXY=http://your-proxy:port

# =============================================
# 웹훅 연동 (선택 - n8n, Make, Zapier 등)
# =============================================
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# =============================================
# 웹 검색 보강 (Grounded Generation)
# =============================================
# Tavily API를 사용하여 YouTube 자막 내용을 웹 검색으로 보강
# https://tavily.com/ — 무료 플랜 1,000 요청/월
TAVILY_API_KEY=
# 웹 검색 자동 활성화 여부 (true 설정 시 모든 생성에 적용)
WEB_SEARCH_ENABLED=false
# 검색 결과 최대 개수 (1~10)
WEB_SEARCH_MAX_RESULTS=5

# =============================================
# RAG 지식 참조 (벡터 DB)
# =============================================
# 참고 문서를 업로드하면 콘텐츠 생성 시 자동 참조
RAG_ENABLED=false
CHROMA_DB_PATH=./data/chroma_db
RAG_TOP_K=5

# =============================================
# Rate Limiter / Redis
# =============================================
# Redis URL — 멀티 워커(gunicorn) 환경에서는 필수
# FLASK_ENV=production 인 경우 미설정 시 부팅 실패 (RuntimeError)
# 개발 환경에서는 미설정 시 인메모리 폴백 (단일 프로세스 전용)
REDIS_URL=redis://localhost:6379/0

# Rate Limiter 전체 on/off (기본: true)
# RATE_LIMIT_ENABLED=true

# =============================================
# Flask / 서버 설정
# =============================================
# 프로덕션: production / 개발: development / 테스트: testing
FLASK_ENV=development
# FLASK_DEBUG=0

# 요청 본문 최대 크기(MB) — 기본 25 (RAG 파일 업로드 허용)
MAX_CONTENT_LENGTH_MB=25

# CORS 허용 origin (쉼표로 구분)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# CSP 오버라이드 (선택)
# CONTENT_SECURITY_POLICY=default-src 'self'; ...

# =============================================
# 스케줄러 (멀티 워커 환경에서 중복 실행 방지)
# =============================================
# RUN_SCHEDULER=1 → 이 프로세스에서 APScheduler 실행
# RUN_SCHEDULER=0 → 비활성화 (다른 컨테이너에서 단일 실행)
# 미설정 시: FLASK_ENV=production → 0, 그 외 → 1
# docker-compose 사용 시 backend는 0, scheduler 컨테이너는 1로 설정됨
# RUN_SCHEDULER=1

# =============================================
# 운영 관측 — Prometheus /metrics
# =============================================
# /metrics 엔드포인트는 기본 인증 없이 노출됩니다.
# 외부 접근을 차단하려면 토큰을 설정하세요. 스크래퍼는 Authorization: Bearer <토큰> 헤더 사용.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(24))"
METRICS_AUTH_TOKEN=

# 백업 보관 개수 (기본 30)
# MAX_BACKUPS=30

# 자동 백업 주기 (시간). 미설정 시 비활성. 스케줄러 컨테이너에서만 실행됨.
# AUTO_BACKUP_INTERVAL_HOURS=6

# =============================================
# Sentry 에러 트래킹 (선택, 프로덕션 권장)
# =============================================
# https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# 성능 트레이싱 샘플링 비율 (0.0 ~ 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
# 릴리즈 식별자 (배포 자동화에서 git SHA 주입 권장)
# SENTRY_RELEASE=

# =============================================
# 프로덕션 배포 체크리스트
# =============================================
# [ ] 모든 AI Provider API 키 = 새로 발급된 값 (.env 평문 노출 가정 → 로테이션)
# [ ] ENCRYPTION_SECRET = 32+ 문자 랜덤 시크릿
# [ ] REDIS_URL = 외부 Redis 또는 docker-compose redis 서비스
# [ ] SENTRY_DSN = 설정됨
# [ ] METRICS_AUTH_TOKEN = 24자 이상 랜덤 토큰 (/metrics 보호, production 필수)
# [ ] FLASK_ENV=production
# [ ] CORS_ORIGINS = 실제 프로덕션 도메인만 명시
# [ ] docker-compose 사용 시 scheduler 컨테이너 1개만 실행
