# =============================================
# Insight Engine - 환경 변수 설정
# =============================================
# 이 파일을 .env로 복사하고 값을 채워넣으세요
# Railway에서는 Variables 탭에서 설정

# 로컬 무인증 개발은 반드시 development를 명시합니다.
# 운영에서는 production으로 바꾸고 아래 Supabase/보안 필수값을 설정하세요.
FLASK_ENV=development

# =============================================
# AI Provider
# =============================================
# 기본 생성은 CLIProxyAPI v7.2.152(OpenAI 호환 로컬 게이트웨이)을 사용합니다.
# 설치와 최초 Codex 로그인은 README의 cliproxyapi-login 절차를 따르세요.
# 기본 모델: cliproxyapi/gpt-5.5
CLIPROXYAPI_BASE_URL=http://127.0.0.1:8317/v1
# 필수: 서버와 백엔드에 동일한 새 난수 키를 설정하세요. 예제 키/빈 값은 사용할 수 없습니다.
# 생성 예시: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLIPROXYAPI_API_KEY=
# 선택: 게이트웨이에서 제공하는 추가 모델 이름을 쉼표로 구분(cliproxyapi/ 접두사 제외).
CLIPROXYAPI_MODELS=
# 운영 Compose는 새 insight_cliproxyapi_auth 볼륨에만 로그인 정보를 저장합니다.
# 기존 ChatMock 인증 볼륨은 마운트하거나 변환하지 않습니다.

# 선택: 이미지/TTS 등 OpenAI 직접 기능을 별도로 쓸 때만 설정
OPENAI_API_KEY=

# =============================================
# Supadata API (선택 - 자막 백업 서비스)
# =============================================
# YouTube 자막이 차단될 경우 백업으로 사용
# https://supadata.ai/
SUPADATA_API_KEY=

# =============================================
# YouTube API (선택 - 댓글 수집용)
# =============================================
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your-youtube-api-key

# Google Docs API 폴백을 Agent 도구에서 사용할 때만 설정합니다.
# 모델 인자로는 노출되지 않고 서버 환경변수로만 주입됩니다.
GOOGLE_DOCS_API_KEY=

# 독립 stdio MCP에서 인증된 /generate 도구를 노출할 때만 설정합니다.
# 토큰이 비어 있으면 로컬 복잡도 분석 도구만 노출됩니다.
INSIGHT_ENGINE_URL=http://localhost:5001
INSIGHT_ENGINE_API_TOKEN=

# =============================================
# Supabase (로컬 development에서는 선택, production에서는 필수)
# =============================================
# Supabase Dashboard > Settings > API Keys에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# 운영 관리자 판별·전체 통계·백그라운드 작업에 필수. 브라우저에 노출 금지.
SUPABASE_SECRET_KEY=your-secret-key
# 기존 프로젝트의 legacy 키도 호환됩니다. 새 키와 동시에 설정할 필요는 없습니다.
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================
# 보안 설정 (production 필수)
# =============================================
# API 키 암호화용 시크릿 (32자 이상 권장)
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_SECRET=your-encryption-secret-key-here

# =============================================
# Whisper 음성 인식 (선택 - 자막 없는 영상용)
# =============================================
# 자막이 없는 영상에 대해 오디오를 추출하고 Whisper로 음성 인식
# GPU 권장 (CPU에서도 동작하나 느림)
# 모델 크기: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_ENABLED=false
WHISPER_MODEL_SIZE=base

# =============================================
# 프록시 설정 (선택 - YouTube 자막 차단 우회용)
# =============================================
# YT_HTTP_PROXY=http://your-proxy:port
# YT_HTTPS_PROXY=http://your-proxy:port

# =============================================
# 웹훅 연동 (선택 - n8n, Make, Zapier 등)
# =============================================
WEBHOOK_URL=
WEBHOOK_ENABLED=false

# =============================================
# 웹 검색 보강 (Grounded Generation)
# =============================================
# Tavily API를 사용하여 YouTube 자막 내용을 웹 검색으로 보강
# https://tavily.com/ — 무료 플랜 1,000 요청/월
TAVILY_API_KEY=
# 웹 검색 자동 활성화 여부 (true 설정 시 모든 생성에 적용)
WEB_SEARCH_ENABLED=false
# 검색 결과 최대 개수 (1~10)
WEB_SEARCH_MAX_RESULTS=5

# =============================================
# RAG 지식 참조 (벡터 DB)
# =============================================
# 참고 문서를 업로드하면 콘텐츠 생성 시 자동 참조
RAG_ENABLED=false
CHROMA_DB_PATH=./data/chroma_db
RAG_TOP_K=5

# =============================================
# Rate Limiter / Redis (선택)
# =============================================
# Redis URL — 설정하면 Rate Limiter가 Redis 저장소 사용 (멀티 프로세스 지원)
# 미설정 시 인메모리 폴백 (단일 프로세스 개발용)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiter 전체 on/off (기본: true)
# RATE_LIMIT_ENABLED=true

# =============================================
# Flask 설정
# =============================================
# FLASK_ENV=production
# FLASK_DEBUG=0

# =============================================
# 운영 배포 준비 검증 (배포 환경에서 필수)
# =============================================
# 실제 배포 도메인만 쉼표로 나열한다. localhost, *, null, file:// 금지.
# CORS_ORIGINS=https://app.example.com
# 외부 공유 URL·RSS·보안 헤더에 쓸 단일 canonical HTTPS origin입니다.
# PUBLIC_ORIGIN=https://app.example.com
#
# /metrics 보호용 토큰. 하드코딩하지 말고 배포 환경 Secret으로 주입한다.
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
# METRICS_AUTH_TOKEN=
#
# 운영 Rate Limit 공유 저장소. 멀티 프로세스/멀티 인스턴스에서는 필수.
# REDIS_URL=redis://redis:6379/0
#
# 운영에서는 원본 볼륨과 장애 경계가 분리된 플랫폼/원격 백업이 필수입니다.
# Railway 볼륨의 manual/automated backup을 먼저 구성한 뒤 true로 확인합니다.
# PLATFORM_VOLUME_BACKUPS_ENABLED=true
#
# 다른 플랫폼으로 옮길 포터블 ZIP도 필요할 때만 보조 백업으로 활성화합니다.
# 같은 볼륨의 ZIP은 PLATFORM_VOLUME_BACKUPS_ENABLED를 대체하지 않습니다.
# AUTO_BACKUP_ENABLED=false
# AUTO_BACKUP_INTERVAL_HOURS=6
# BACKUP_INITIAL_DELAY_SECONDS=300
# MAX_BACKUPS=30
# BACKUP_QUIESCE_TIMEOUT_SECONDS=600
# BACKEND_GRACEFUL_TIMEOUT_SECONDS=600
# NGINX_DRAIN_TIMEOUT_SECONDS=605
# BACKUP_SHUTDOWN_TIMEOUT_SECONDS=10
# PROCESS_SHUTDOWN_TIMEOUT_SECONDS=605
# APP_DATA_DIR=/app/persist/data
# APP_DATA_BACKUP_DIR=/app/persist/backups
#
# Caddy Basic Auth. 해시는 저장소에 넣지 말고 운영 Secret으로 주입합니다.
# CADDY_BASIC_AUTH_USER=
# CADDY_BASIC_AUTH_HASH=
#
# 로컬에서 운영 env 파일을 따로 검증하려면:
# python scripts/check_production_readiness.py --env-file .env.production.local
