:8090 {
    encode gzip zstd

    handle /health {
        reverse_proxy backend:5001
    }

    @publicShare {
        method GET
        path /share/* /api/shares/*
    }
    handle @publicShare {
        reverse_proxy backend:5001
    }

    handle {
        basicauth {
            inbeom $2a$14$2eRC3ysAzH9h1uIdUx0W.uuWpfDGYU2LhAJWtsV1ylsVhqtsGroRm
        }

        @backend path /api/* /generate /generate-stream /generate-batch /feed.xml /version /metrics /openapi.json /oauth/*
        reverse_proxy @backend backend:5001

        reverse_proxy frontend:3000
    }
}
