:8090 {
    encode gzip zstd

    handle /health {
        reverse_proxy backend:5001
    }
    handle /ready {
        reverse_proxy backend:5001
    }

    @publicShare {
        method GET
        path /share/* /api/shares/*
    }
    handle @publicShare {
        reverse_proxy backend:5001
    }

    handle {
        basic_auth {
            {$CADDY_BASIC_AUTH_USER} {$CADDY_BASIC_AUTH_HASH}
        }

        @nextOg path /api/og /api/og/*
        reverse_proxy @nextOg frontend:3000

        @backend path /api/* /generate /generate-stream /generate-batch /feed.xml /version /metrics /openapi.json /oauth/*
        reverse_proxy @backend backend:5001

        reverse_proxy frontend:3000
    }
}
