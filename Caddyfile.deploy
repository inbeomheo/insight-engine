:8090 {
    encode gzip zstd

    header {
        Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    handle /health {
        reverse_proxy backend:5001
    }

    @publicShare {
        method GET
        path /share/* /api/shares/*
    }
    handle @publicShare {
        reverse_proxy backend:5001
    }

    handle {
        basic_auth {
            inbeom $2a$14$2eRC3ysAzH9h1uIdUx0W.uuWpfDGYU2LhAJWtsV1ylsVhqtsGroRm
        }

        @backend path /api/* /generate /generate-stream /generate-batch /feed.xml /version /ready /metrics /openapi.json /oauth/*
        reverse_proxy @backend backend:5001 {
            header_up X-Insight-Proxy-Secret {env.AUTH_PROXY_SECRET}
            header_up X-Insight-Proxy-User inbeom
        }

        reverse_proxy frontend:3000
    }
}
