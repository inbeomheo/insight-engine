// Insight Engine - Views
// 다양한 시점의 아키텍처 다이어그램 정의

views {

  // ─── 1. 시스템 전체 조감도 ───
  view index {
    title 'Insight Engine - System Landscape'
    description '시스템 전체 구조와 외부 의존성'

    include
      user,
      admin,
      insightEngine,
      youtube,
      supadata,
      aiProviders,
      litellm,
      supabase
  }

  // ─── 2. Insight Engine 내부 구조 ───
  view insightEngineInternal of insightEngine {
    title 'Insight Engine - 내부 구조'
    description 'Frontend와 Backend의 주요 모듈'

    include *
  }

  // ─── 3. Frontend 모듈 상세 ───
  view frontendModules of insightEngine.frontend {
    title 'Frontend - 모듈 구조'
    description 'EventBus 기반 Pub/Sub 통신 패턴'

    include *
  }

  // ─── 4. Backend 서비스 상세 ───
  view backendServices of insightEngine.backend {
    title 'Backend - 서비스 레이어'
    description 'Flask 라우트와 서비스 계층'

    include
      *,
      youtube,
      supadata,
      litellm,
      supabase
  }

  // ─── 5. 콘텐츠 생성 플로우 ───
  view contentFlow {
    title '콘텐츠 생성 요청 흐름'
    description 'POST /generate 요청의 전체 데이터 플로우'

    include
      user,
      insightEngine.frontend.contentGenerator,
      insightEngine.backend.blogRoutes,
      insightEngine.backend.usageService,
      insightEngine.backend.contentService,
      insightEngine.backend.promptSystem,
      insightEngine.backend.aiService,
      insightEngine.backend.config,
      youtube,
      supadata,
      litellm,
      aiProviders
  }

  // ─── 6. 인증 플로우 ───
  view authFlow {
    title '인증 및 사용량 관리 흐름'
    description 'OAuth 로그인 → 사용량 체크 → API 접근'

    include
      user,
      insightEngine.frontend.authManager,
      insightEngine.backend.authRoutes,
      insightEngine.backend.supabaseService,
      insightEngine.backend.usageService,
      supabase
  }

  // ─── 7. AI 프로바이더 통합 ───
  view aiIntegration {
    title 'AI 프로바이더 통합 구조'
    description 'LiteLLM을 통한 다중 AI 프로바이더 라우팅'

    include
      insightEngine.backend.aiService,
      insightEngine.backend.config,
      insightEngine.backend.promptSystem,
      litellm,
      aiProviders,
      aiProviders.*
  }

  // ─── 8. 데이터 저장소 ───
  view dataLayer {
    title '데이터 저장소 구조'
    description 'Supabase를 통한 데이터 관리'

    include
      insightEngine.backend.supabaseService,
      insightEngine.backend.authRoutes,
      insightEngine.backend.usageService,
      supabase,
      supabase.*
  }
}
