# Insight Engine Frontend 환경변수
# ./.env.local 로 복사 후 값 채워서 사용

# Flask 백엔드 URL (필수)
# 개발: http://localhost:5001 / 프로덕션: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:5001

# Supabase (선택, 인증 활성화 시 필수)
# 둘 다 빈 값이면 로컬 모드(인증 우회)로 동작
# Supabase Dashboard → Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sentry (선택, 프로덕션 권장)
# @sentry/nextjs 설치 후 사용. lib/errorReporting.ts는 미설치 시 console fallback.
# NEXT_PUBLIC_SENTRY_DSN=
